---
/**
 * ACTO II — el repertorio.
 *
 * Agrupado por categoria y ordenado por nivel de dominio, todo calculado en
 * `utils/collections`. La seccion no sabe ordenar nada: pide y compone.
 *
 * Nota de honestidad tecnica: se muestra el nivel de uso real de cada
 * herramienta en lugar de la clasica barra de "90 %", que no significa nada
 * y nadie sabe medir.
 */
import Section from '@components/ui/Section.astro';
import Card from '@components/ui/Card.astro';
import TechBadge from '@components/ui/TechBadge.astro';
import { getTechByCategory } from '@utils/collections';

const groups = await getTechByCategory();

const CATEGORY_LABEL: Record<string, string> = {
  frontend: 'Escena',
  backend: 'Tramoya',
  datos: 'Archivo',
  infra: 'Maquinaria',
  calidad: 'Ensayos',
  diseno: 'Vestuario',
};

const CATEGORY_HINT: Record<string, string> = {
  frontend: 'Lo que ve el público',
  backend: 'Lo que lo sostiene',
  datos: 'Dónde vive la información',
  infra: 'Cómo llega a producción',
  calidad: 'Lo que impide el desastre',
  diseno: 'Cómo se decide el aspecto',
};
---

<Section
  id="tecnologias"
  tone="sunken"
  lead="Las herramientas con las que trabajo, agrupadas por el papel que cumplen en la obra. Sin barras de porcentaje: solo cuánto peso tiene cada una en mi día a día."
>
  <div class="repertoire" data-reveal-stagger="80">
    {
      groups.map((group) => (
        <Card as="section" variant="outline" padding="md" class="family" data-reveal="rise">
          <header class="family__head">
            <h3 class="family__title">{CATEGORY_LABEL[group.category] ?? group.category}</h3>
            <p class="family__hint">{CATEGORY_HINT[group.category]}</p>
          </header>

          <ul class="family__list">
            {group.items.map((tech) => (
              <li class="family__item">
                <TechBadge tech={tech} size="sm" showLevel={tech.data.level === 'nucleo'} />
                <p class="family__note">{tech.data.note}</p>
              </li>
            ))}
          </ul>
        </Card>
      ))
    }
  </div>
</Section>

<style>
  .repertoire {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  .family {
    height: 100%;
  }

  .family__head {
    margin-bottom: 1.1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .family__title {
    margin: 0;
    font-size: var(--text-lg);
  }

  .family__hint {
    margin: 0.2rem 0 0;
    font-size: var(--text-2xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .family__list {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .family__item {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
  }

  .family__note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--text-subtle);
    line-height: 1.5;
  }
</style>
