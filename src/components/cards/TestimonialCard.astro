---
/**
 * TARJETA DE TESTIMONIO — la critica.
 *
 * Semantica correcta: `<figure>` + `<blockquote>` + `<figcaption>`. Es la
 * unica combinacion que ata la cita a su autor en el arbol de accesibilidad;
 * un `<div>` con comillas tipograficas no dice nada a un lector de pantalla.
 *
 * El avatar son iniciales generadas del propio dato: sin fotos de terceros,
 * sin peticiones extra y sin problemas de derechos de imagen.
 */
import Card from '@components/ui/Card.astro';
import type { TestimonialEntry } from '@utils/collections';
import { cn } from '@utils/cn';

interface Props {
  testimonial: TestimonialEntry;
  class?: string;
}

const { testimonial, class: className } = Astro.props;
const { quote, author, role, company, initials, relation, url } = testimonial.data;

const RELATION_LABEL: Record<typeof relation, string> = {
  cliente: 'Cliente',
  companero: 'Compañero de equipo',
  responsable: 'Responsable directo',
};
---

<Card as="figure" padding="lg" class={cn('review', className)} data-reveal="rise">
  <span class="review__mark" aria-hidden="true">&ldquo;</span>

  <blockquote class="review__quote">
    <p>{quote}</p>
  </blockquote>

  <figcaption class="review__author">
    <span class="review__avatar" aria-hidden="true">{initials}</span>
    <span class="review__identity">
      <span class="review__name">
        {
          url ? (
            <a href={url} target="_blank" rel="noopener noreferrer">
              {author}
            </a>
          ) : (
            author
          )
        }
      </span>
      <span class="review__role">{role} · {company}</span>
    </span>
    <span class="review__relation">{RELATION_LABEL[relation]}</span>
  </figcaption>
</Card>

<style>
  .review {
    position: relative;
    height: 100%;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  /* Comilla decorativa: grande, tenue y fuera del flujo del texto. */
  .review__mark {
    position: absolute;
    top: -0.35em;
    right: 0.5rem;
    font-family: var(--font-display);
    font-size: 6rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.14;
    pointer-events: none;
  }

  .review__quote {
    position: relative;
    margin: 0;
    flex: 1;
  }

  .review__quote p {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--text);
  }

  .review__author {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 0.35rem 0.85rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .review__avatar {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: linear-gradient(140deg, var(--accent), var(--curtain));
    color: var(--accent-contrast);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .review__identity {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .review__name {
    font-weight: 600;
    color: var(--text);
  }

  .review__name a {
    text-decoration: none;
  }

  .review__name a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .review__role {
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .review__relation {
    grid-column: 2;
    justify-self: start;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }
</style>
