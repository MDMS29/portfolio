---
/**
 * PARADA DE LA GIRA — un elemento de la linea temporal.
 *
 * Recibe datos estructurados para el caso comun y deja un slot para lo
 * variable (las insignias de tecnologia). Es el equilibrio entre un
 * componente rigido y uno que solo son slots y no aporta nada.
 */
import { Icon } from 'astro-icon/components';
import { cn } from '@utils/cn';

interface Props {
  title: string;
  organization: string;
  organizationUrl?: string;
  /** Ya formateado: "feb 2023 — actualidad". */
  period: string;
  duration?: string;
  location?: string;
  mode?: string;
  summary?: string;
  highlights?: string[];
  /** Marca el puesto actual con un punto vivo. */
  current?: boolean;
  class?: string;
}

const {
  title,
  organization,
  organizationUrl,
  period,
  duration,
  location,
  mode,
  summary,
  highlights = [],
  current = false,
  class: className,
} = Astro.props;
---

<li class={cn('stop', current && 'stop--current', className)} data-reveal="left">
  <span class="stop__marker" aria-hidden="true"></span>

  <div class="stop__head">
    <h3 class="stop__title">{title}</h3>
    <p class="stop__org">
      {
        organizationUrl ? (
          <a href={organizationUrl} target="_blank" rel="noopener noreferrer">
            {organization}
            <Icon name="lucide:arrow-up-right" aria-hidden="true" />
          </a>
        ) : (
          organization
        )
      }
    </p>
  </div>

  <p class="stop__meta">
    <span class="stop__period">{period}</span>
    {duration && <span class="stop__chip">{duration}</span>}
    {location && <span class="stop__chip">{location}</span>}
    {mode && <span class="stop__chip stop__chip--mode">{mode}</span>}
  </p>

  {summary && <p class="stop__summary">{summary}</p>}

  {
    highlights.length > 0 && (
      <ul class="stop__highlights">
        {highlights.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }

  <div class="stop__stack">
    <slot />
  </div>
</li>

<style>
  .stop {
    position: relative;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .stop:last-child {
    padding-bottom: 0;
  }

  .stop__marker {
    position: absolute;
    top: 0.5rem;
    left: calc(var(--timeline-offset, 1.75rem) * -1);
    width: 9px;
    height: 9px;
    translate: -4px 0;
    border-radius: 50%;
    background: var(--border-strong);
    outline: 4px solid var(--bg);
  }

  .stop--current .stop__marker {
    background: var(--accent);
  }

  /* Halo latiendo solo en el puesto actual: un unico elemento animado. */
  .stop--current .stop__marker::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    background: var(--accent);
    animation: theater-pulse-ring 2.6s ease-out infinite;
  }

  .stop__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
  }

  .stop__title {
    margin: 0;
    font-size: var(--text-xl);
  }

  .stop__org {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--accent);
    font-weight: 600;
  }

  .stop__org a {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    text-decoration: none;
  }

  .stop__org a:hover {
    text-decoration: underline;
  }

  .stop__org :global(svg) {
    width: 0.85em;
    height: 0.85em;
  }

  .stop__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    font-size: var(--text-xs);
    color: var(--text-subtle);
  }

  .stop__period {
    font-weight: 600;
    color: var(--text-muted);
  }

  .stop__chip {
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .stop__chip--mode {
    text-transform: capitalize;
  }

  .stop__summary {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    max-width: 64ch;
  }

  .stop__highlights {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    max-width: 68ch;
  }

  .stop__highlights li {
    position: relative;
    padding-left: 1.1rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Vineta en forma de foco de escena. */
  .stop__highlights li::before {
    content: '';
    position: absolute;
    top: 0.62em;
    left: 0;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.65;
  }

  .stop__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.1rem;
  }

  .stop__stack:empty {
    display: none;
  }
</style>
