---
/**
 * TELON EQUIVOCADO — pagina 404.
 * `noindex` para que no acabe en los resultados de busqueda.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';
import Stage from '@components/theater/Stage.astro';
import { NAV_ACTS } from '@data/navigation';
---

<BaseLayout
  title="Esta sala está vacía"
  description="La página que buscas no existe o ha cambiado de sitio."
  noindex
>
  <section class="lost" aria-labelledby="lost-titulo">
    <div class="stage-container">
      <Stage size="full">
        <div class="lost__inner">
          <p class="lost__code" aria-hidden="true">404</p>
          <h1 id="lost-titulo" class="lost__title">Esta sala está vacía</h1>
          <p class="lost__text">
            Has abierto una puerta que no da a ningún escenario. Puede que la función
            se trasladara de sala o que la dirección tenga una errata.
          </p>

          <div class="lost__actions">
            <Button href="/" size="lg" iconStart="lucide:home">Volver al vestíbulo</Button>
            <Button href="/#proyectos" variant="secondary" size="lg" iconEnd="lucide:arrow-right">
              Ver las obras en cartel
            </Button>
          </div>

          <nav class="lost__nav" aria-label="Actos disponibles">
            <p class="lost__nav-title">O ve directamente a un acto</p>
            <ul>
              {
                NAV_ACTS.map((act) => (
                  <li>
                    <a href={`/#${act.id}`}>{act.label}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>
      </Stage>
    </div>
  </section>
</BaseLayout>

<style>
  .lost__inner {
    max-width: 46rem;
    margin-inline: auto;
    text-align: center;
  }

  .lost__code {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(5rem, 20vw, 11rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px var(--border-strong);
    opacity: 0.75;
  }

  .lost__title {
    margin: 0.5rem 0 0;
    font-size: var(--text-3xl);
  }

  .lost__text {
    margin: 1rem auto 0;
    max-width: 48ch;
    color: var(--text-muted);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .lost__nav {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .lost__nav-title {
    margin: 0 0 0.85rem;
    font-size: var(--text-2xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-subtle);
  }

  .lost__nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .lost__nav a {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-soft),
      border-color var(--dur-fast) var(--ease-soft);
  }

  .lost__nav a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
