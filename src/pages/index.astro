---
/**
 * LA FUNCION COMPLETA.
 *
 * Esta pagina no contiene ni una linea de maquetacion: solo declara el orden
 * de los actos. Es la prueba de que la arquitectura funciona — si para
 * reordenar la obra hubiera que tocar CSS, algo estaria mal repartido.
 */
import BaseLayout from '@layouts/BaseLayout.astro';

import HeroSection from '@sections/HeroSection.astro';
import AboutSection from '@sections/AboutSection.astro';
import TechSection from '@sections/TechSection.astro';
import ExperienceSection from '@sections/ExperienceSection.astro';
import ProjectsSection from '@sections/ProjectsSection.astro';
import ServicesSection from '@sections/ServicesSection.astro';
import CertificationsSection from '@sections/CertificationsSection.astro';
import TestimonialsSection from '@sections/TestimonialsSection.astro';
import ContactSection from '@sections/ContactSection.astro';
---

<BaseLayout curtain>
  <HeroSection />
  <AboutSection />
  <TechSection />
  <ExperienceSection />
  <ProjectsSection />
  <ServicesSection />
  <CertificationsSection />
  <TestimonialsSection />
  <ContactSection />
</BaseLayout>
